GIPHY_API_KEY=your_giphy_api_key
GIPHY_COUNTRY_CODE=IN

# Optional request-budget overrides
GIPHY_REQUESTS_PER_HOUR=90
GIPHY_REQUESTS_PER_PLAYER_PER_HOUR=30

# Music bot (@DJ). Without a key, players can still paste YouTube links.
YOUTUBE_API_KEY=your_youtube_data_api_key
# Optional: region for search results, and the uncached-search budget.
# Each search costs ~101 of YouTube's default 10,000 daily quota units.
YOUTUBE_REGION_CODE=IN
YOUTUBE_SEARCHES_PER_DAY=95
YOUTUBE_SEARCHES_PER_PLAYER_PER_HOUR=20
